rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Helper functions
    function isSignedIn() {
      return request.auth != null;
    }
    
    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    // Default deny rule
    match /{document=**} {
      allow read, write: if false;
    }

    // Security Breach Logs (Readable & Writeable for signal alert security)
    match /security_breaches/{breachId} {
      allow read, write: if true;
    }

    // Teachers Collection
    match /teachers/{teacherId} {
      allow read, write: if isSignedIn();
    }

    // Curriculum Competencies Collection
    match /competencies/{compId} {
      allow read: if true;
      allow write: if isSignedIn();
    }

    // ILAW Lesson Plans Collection
    match /ilaw_plans/{planId} {
      allow read, write: if isSignedIn();
    }

    // Grading Sheets & School Forms
    match /grading_sheets/{sheetId} {
      allow read, write: if isSignedIn();
    }

    // Chat Workspace Messages
    match /chats/{chatId} {
      allow read, write: if isSignedIn();
    }

    // Saved Project Drafts
    match /projects/{projectId} {
      allow read, write: if isSignedIn();
    }
  }
}
